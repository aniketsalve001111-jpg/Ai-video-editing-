<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16.dp"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI Video Editor"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16.dp"/>

        <!-- Select Video Button -->
        <Button
            android:id="@+id/btnSelectVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="मोबाइल से वीडियो चुनें"
            android:backgroundTint="#6200EE"
            android:textColor="#FFFFFF"/>

        <TextView
            android:id="@+id/tvVideoPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="कोई वीडियो चयनित नहीं है"
            android:textColor="#AAAAAA"
            android:layout_marginTop="8.dp"
            android:layout_marginBottom="16.dp"/>

        <!-- Voice Command Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voice Command (Hindi / Marathi / English)"
            android:textColor="#FFFFFF"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/etVoiceCommand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="जैसे: इस वीडियो को cinematic बनाओ..."
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"
            android:backgroundTint="#FFFFFF"
            android:layout_marginBottom="8.dp"/>

        <Button
            android:id="@+id/btnProcessCommand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="एक्टिवेट एडिटिंग प्लान"
            android:backgroundTint="#03DAC5"
            android:textColor="#000000"/>

        <!-- Editing Plan & Options Layout -->
        <LinearLayout
            android:id="@+id/layoutEditingPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="#1E1E1E"
            android:padding="12.dp"
            android:layout_marginTop="16.dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Editing Plan:"
                android:textStyle="bold"
                android:textColor="#FFEB3B"/>

            <TextView
                android:id="@+id/tvPlanDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Plan text here..."
                android:textColor="#FFFFFF"
                android:layout_marginTop="4.dp"
                android:layout_marginBottom="12.dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnApplyChanges"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="सब लागू करें"
                    android:backgroundTint="#4CAF50"
                    android:textColor="#FFFFFF"/>

                <Space
                    android:layout_width="8.dp"
                    android:layout_height="match_parent"/>

                <Button
                    android:id="@+id/btnModifyChanges"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="बदलाव करें"
                    android:backgroundTint="#FF9800"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Prompt Center -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prompt Center"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="20.dp"/>

        <EditText
            android:id="@+id/etPositivePrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Positive Prompt (Cinematic, 4K, Stable)"
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"/>

        <EditText
            android:id="@+id/etNegativePrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Negative Prompt (Blur, Noise, Distortion)"
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"/>

        <!-- Export & Progress -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="16.dp"/>

        <Button
            android:id="@+id/btnExport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4K Export & Save"
            android:backgroundTint="#FF5722"
            android:textColor="#FFFFFF"
            android:layout_marginTop="16.dp"/>

    </LinearLayout>
</ScrollView>
